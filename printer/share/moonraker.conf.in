# Generated by zforge on every Moonraker start. Do not edit:
# put your changes in @USER_CONF@ instead.

[server]
host: 0.0.0.0
# Plain HTTP. zforge's firewall blocks it from the network (always), so it
# is reachable from the printer itself only. Clients use HTTPS below.
port: @HTTP_PORT@
ssl_port: @HTTPS_PORT@
klippy_uds_address: /tmp/uds
max_upload_size: 1024

[machine]
provider: none
validate_service: False

[file_manager]
# the stock kernel has no inotify
file_system_observer: none
enable_object_processing: False

[authorization]
# API key only: no trusted clients, CORS at Moonraker's default (off).
enable_api_key: True

[octoprint_compat]
# OrcaSlicer's "Octo/Klipper" host type uploads through the OctoPrint API

[history]

[include @USER_CONF@]

# ---- Enforced by zforge: these come after the user include so they always
# win. The firewall and the API-key-only policy depend on them.
[server]
host: 0.0.0.0
port: @HTTP_PORT@
ssl_port: @HTTPS_PORT@
klippy_uds_address: /tmp/uds

[authorization]
enable_api_key: True
trusted_clients:
cors_domains:
