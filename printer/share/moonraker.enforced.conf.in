# Generated by zforge. Included after the user file, so these always win:
# the firewall and the API-key-only policy depend on them.

[server]
host: 0.0.0.0
# Plain HTTP: zforge's firewall blocks it from the network in every profile,
# so it is reachable from the printer itself only. Clients use HTTPS.
port: @HTTP_PORT@
ssl_port: @HTTPS_PORT@
klippy_uds_address: /tmp/uds
max_upload_size: 1024

[authorization]
# API key only: no trusted clients, CORS off (Moonraker's default).
enable_api_key: True
trusted_clients:
cors_domains:
